{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/processes-start-request.schema.json",
  "title": "processes-start-request",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "enum": [
        "sh",
        "bash"
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    }
  },
  "required": [
    "path",
    "script",
    "executable"
  ],
  "additionalProperties": false
}
