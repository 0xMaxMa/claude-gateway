{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/processes-stop-response.schema.json",
  "title": "processes-stop-response",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "stopped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "pids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "port",
          "pids"
        ],
        "additionalProperties": false
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "pids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "port",
          "pids"
        ],
        "additionalProperties": false
      }
    },
    "running": {
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "stopped",
    "remaining",
    "running"
  ],
  "additionalProperties": false
}
