{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/processes-list.schema.json",
  "title": "processes-list",
  "type": "object",
  "properties": {
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "running": {
            "type": "boolean"
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                },
                "pids": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "command": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                }
              },
              "required": [
                "port",
                "pids",
                "command",
                "address"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "running",
          "listeners"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "processes"
  ],
  "additionalProperties": false
}
