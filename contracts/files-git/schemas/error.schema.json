{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/error.schema.json",
  "title": "Error",
  "description": "Body of every error the files and git routes answer. website/api/files.md lists each code with its status.",
  "type": "object",
  "required": [
    "error",
    "code"
  ],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "enum": [
        "invalid_path",
        "invalid_name",
        "not_a_directory",
        "confirm_mismatch",
        "path_escape",
        "permission_denied",
        "forbidden_key",
        "not_found",
        "already_exists",
        "symlink_in_path",
        "cross_device",
        "in_use",
        "deleting",
        "not_a_git_repo",
        "git_unsafe_owner",
        "git_unreadable",
        "internal",
        "git_failed",
        "git_unavailable",
        "timeout"
      ]
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "turn",
          "spawn",
          "task",
          "session",
          "marked",
          "deleting"
        ]
      }
    }
  }
}
