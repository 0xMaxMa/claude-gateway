{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/processes-start-response.schema.json",
  "title": "processes-start-response",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "pid": {
      "type": "integer",
      "minimum": 0
    },
    "running": {
      "const": true
    }
  },
  "required": [
    "path",
    "port",
    "pid",
    "running"
  ],
  "additionalProperties": false
}
