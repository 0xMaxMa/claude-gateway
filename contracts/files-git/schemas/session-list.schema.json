{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway.dev/contracts/files-git/session-list.schema.json",
  "title": "SessionList",
  "description": "200 body of GET /v1/agents/:agentId/sessions, including cwd binding fields.",
  "type": "object",
  "required": [
    "sessions"
  ],
  "properties": {
    "activeSessionId": {
      "type": "string"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cwd",
          "trusted",
          "cwdState",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "trusted": {
            "type": "boolean"
          },
          "cwdState": {
            "enum": [
              "available",
              "missing",
              "unavailable",
              null
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
