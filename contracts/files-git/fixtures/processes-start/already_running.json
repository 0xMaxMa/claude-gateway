{
  "request": {
    "method": "POST",
    "url": "/api/v1/processes/start",
    "key": "admin",
    "body": {
      "path": "site",
      "script": "scripts/serve.sh",
      "executable": "sh",
      "port": 3001
    }
  },
  "status": 409,
  "schema": "ProcessesError",
  "body": {
    "error": "A process working in this folder already listens, or a start of it is running",
    "code": "already_running",
    "port": 3001
  }
}
